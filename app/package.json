{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "kipple desktop app (Tauri 2 + Svelte 5)",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint src scripts",
    "icons": "node --experimental-strip-types --no-warnings scripts/render-icons.ts && tauri icon src-tauri/icons/source.png -o src-tauri/icons && node -e \"for (const d of ['android','ios']) require('node:fs').rmSync('src-tauri/icons/'+d,{recursive:true,force:true})\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@kipple/client": "workspace:*",
    "@kipple/design": "workspace:*",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
