{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kipple",
  "version": "0.1.0",
  "identifier": "dev.kipple.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "kipple",
        "url": "index.html",
        "width": 1328,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground",
            "mica"
          ],
          "state": "followsWindowActiveState"
        },
        "trafficLightPosition": {
          "x": 34,
          "y": 36
        }
      },
      {
        "label": "tray",
        "title": "kipple menu bar",
        "url": "tray.html",
        "width": 380,
        "height": 470,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Find and safely reclaim disk space used by developer tools",
    "copyright": "kipple contributors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
