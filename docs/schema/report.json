{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report",
  "description": "Latest scan report: summary plus heaviest projects.",
  "type": "object",
  "properties": {
    "next": {
      "description": "What `kipple clean --safe-only` would do.",
      "anyOf": [
        {
          "$ref": "#/$defs/NextStep"
        },
        {
          "type": "null"
        }
      ]
    },
    "scan": {
      "$ref": "#/$defs/ScanInfo"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "top_projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectSummary"
      }
    }
  },
  "required": [
    "scan",
    "summary",
    "top_projects"
  ],
  "$defs": {
    "Category": {
      "description": "What kind of junk an item is. Drives grouping and colors.",
      "type": "string",
      "enum": [
        "project-artifact",
        "package-cache",
        "toolchain",
        "container",
        "mobile",
        "ai-history",
        "model",
        "ide-cache",
        "build-cache",
        "logs",
        "system"
      ]
    },
    "CategorySummary": {
      "description": "One row of the per-category summary.",
      "type": "object",
      "properties": {
        "by_safety": {
          "$ref": "#/$defs/SafetyMix"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "items": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reclaimable": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "category",
        "items",
        "reclaimable",
        "by_safety"
      ]
    },
    "LastUsed": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/LastUsedSource"
        }
      },
      "required": [
        "at",
        "source"
      ]
    },
    "LastUsedSource": {
      "type": "string",
      "enum": [
        "git_commit",
        "git_index",
        "source_mtime",
        "item_mtime",
        "tool_metadata",
        "atime"
      ]
    },
    "NextStep": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "keep_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reclaimable": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "undoable": {
          "description": "Part of `reclaimable` that can be undone during the quarantine window.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "command",
        "reclaimable",
        "undoable",
        "keep_days"
      ]
    },
    "ProjectId": {
      "description": "`blake3(canonical project root)`, first 16 bytes, hex.",
      "type": "string"
    },
    "ProjectSummary": {
      "description": "A source-code directory and the items attributed to it (SPEC §4.2).",
      "type": "object",
      "properties": {
        "by_category": {
          "description": "Reclaimable bytes per category.",
          "type": "object",
          "properties": {
            "ai-history": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "build-cache": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "container": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "ide-cache": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "logs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "mobile": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "model": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "package-cache": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "project-artifact": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "system": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "toolchain": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "exists": {
          "description": "`false` when tool metadata points to a folder that no longer exists.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/ProjectId"
        },
        "item_count": {
          "description": "Number of attributed items.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "last_used": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastUsed"
            },
            {
              "type": "null"
            }
          ]
        },
        "markers": {
          "description": "Marker files found at the root: `package.json`, `.git`, …",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "description": "Package name if known, else folder name.",
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "safety_mix": {
          "$ref": "#/$defs/SafetyMix"
        },
        "total": {
          "description": "Sum of attributed items.",
          "$ref": "#/$defs/Size"
        }
      },
      "required": [
        "id",
        "root",
        "name",
        "markers",
        "total",
        "by_category",
        "safety_mix",
        "exists"
      ]
    },
    "SafetyMix": {
      "description": "Reclaimable bytes per safety level.",
      "type": "object",
      "properties": {
        "keep": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "safe": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "safe",
        "review",
        "keep"
      ]
    },
    "ScanId": {
      "description": "ULID of a scan.",
      "type": "string"
    },
    "ScanInfo": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "entries_seen": {
          "description": "Directory entries visited by the walk.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ScanId"
        },
        "kipple_version": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScanStatus"
        }
      },
      "required": [
        "id",
        "started_at",
        "roots",
        "kipple_version",
        "status",
        "entries_seen",
        "duration_ms"
      ]
    },
    "ScanStatus": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "cancelled",
        "failed"
      ]
    },
    "Size": {
      "description": "Honest sizes (SPEC §5.5).",
      "type": "object",
      "properties": {
        "apparent": {
          "description": "Sum of file lengths.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "on_disk": {
          "description": "Allocated blocks.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reclaimable": {
          "description": "What deleting frees, after hardlink and shared-store accounting.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "apparent",
        "on_disk",
        "reclaimable"
      ]
    },
    "Summary": {
      "description": "Report numbers for one scan.",
      "type": "object",
      "properties": {
        "by_safety": {
          "$ref": "#/$defs/SafetyMix"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CategorySummary"
          }
        },
        "items": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "quarantine_bytes": {
          "description": "Bytes held in quarantine, not yet freed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reclaimable": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "items",
        "reclaimable",
        "by_safety",
        "categories",
        "quarantine_bytes"
      ]
    }
  }
}
